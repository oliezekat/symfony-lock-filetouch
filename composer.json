{
    "name": "oliezekat/symfony-lock-filetouch",
    "type": "library",
    "description": "Files touch() storage implementation for Symfony Lock component",
    "keywords": ["symfony","lock"],
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "oliezekat",
            "email": "oliezekat@yahoo.fr",
            "homepage": "https://life2front.com/oliezekat/"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/lock": "^6.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^9.6 || ^11.5"
	},
    "autoload": {
        "psr-4": {
            "Oliezekat\\SymfonyLockFileTouch\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oliezekat\\SymfonyLockFileTouch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
