<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="SymfonyLockFileTouch Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>

    <logging>
        <junit outputFile="var/outputs/phpunit/logfile.xml"/>
        <testdoxText outputFile="var/outputs/phpunit/testdox.txt"/>
    </logging>
</phpunit>
